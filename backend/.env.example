# Port the HTTP server listens on.
CODEATLAS_PORT=8080

# PostgreSQL connection string. Falls back to in-memory repositories if unset.
CODEATLAS_DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign/verify session JWTs. Generate with: openssl rand -hex 32
CODEATLAS_JWT_SECRET=<64-char hex string from: openssl rand -hex 32>

# 32-byte AES key (hex-encoded) used to encrypt stored OAuth tokens. Generate with: openssl rand -hex 32
CODEATLAS_ENCRYPTION_KEY=<64-char hex string from: openssl rand -hex 32>

# GitHub OAuth app credentials, from github.com/settings/developers
CODEATLAS_GITHUB_CLIENT_ID=<from github.com/settings/developers>
CODEATLAS_GITHUB_CLIENT_SECRET=<from github.com/settings/developers>

# GitLab OAuth app credentials, from gitlab.com/-/user_settings/applications
CODEATLAS_GITLAB_CLIENT_ID=<from gitlab.com/-/user_settings/applications>
CODEATLAS_GITLAB_CLIENT_SECRET=<from gitlab.com/-/user_settings/applications>

# Public base URL of this backend, used to build OAuth redirect_uri values.
CODEATLAS_APP_BASE_URL=https://your-backend-url

# Public URL of the frontend, used for CORS and post-login redirects.
CODEATLAS_FRONTEND_URL=https://your-frontend-url
